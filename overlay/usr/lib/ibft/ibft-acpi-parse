#!/bin/sh
# Print the boot settings of an iBFT ACPI table (the binary
# /sys/firmware/acpi/tables/iBFT) as KEY=value lines. For machines whose kernel
# has no iscsi_ibft driver and so no /sys/firmware/ibft (Flatcar's arm64 kernel).
# Runs in the initrd's busybox, which has hexdump and awk (but no od).
#
# usage: ibft-acpi-parse TABLE
#
# Output: IBFT_INITIATOR, IBFT_MAC (lower case), IBFT_IP, IBFT_PREFIX,
# IBFT_GATEWAY, IBFT_TARGET_IP, IBFT_TARGET_PORT, IBFT_TARGET_NAME.
# The values are checked to hold only characters of names and addresses, so the
# output is safe to read back with sed or to source.
#
# Layout (iSCSI Boot Firmware Table, Microsoft/IBM spec v1.0): a 48-byte header
# (ACPI header, signature "iBFT", then 12 reserved bytes), then the control
# structure, which holds the offsets (from the table start) of the initiator,
# NIC 0, target 0, NIC 1 and target 1 structures. Every structure starts with
# id, version, length (2 bytes), index, flags (bit 0: block valid); ids are
# 1 control, 2 initiator, 3 NIC, 4 target. Strings sit elsewhere in the table,
# at an offset from its start. Addresses are 16 bytes, IPv4 as ::ffff:a.b.c.d.
# A valid target with the "firmware boot selected" flag (bit 1) is used, else the
# first valid one, and the NIC it names (else the first valid NIC). VLAN is ignored.
set -eu
if [ $# -ne 1 ] || [ ! -r "$1" ]; then
    echo "usage: ibft-acpi-parse TABLE" >&2
    exit 2
fi

hexdump -v -e '16/1 "%u " "\n"' "$1" | awk '
function fail(msg) { print "ibft-acpi-parse: " msg > "/dev/stderr"; exit 1 }
function u16(o) { return b[o] + b[o + 1] * 256 }
function u32(o) { return u16(o) + u16(o + 2) * 65536 }
# IPv4 address at o: IPv4-mapped (or all zero, for "none").
function ip4(o,   i, zero) {
  zero = 1
  for (i = 0; i < 16; i++) if (b[o + i] != 0) zero = 0
  if (!zero && (b[o + 10] != 255 || b[o + 11] != 255)) fail("not an IPv4 address")
  return b[o + 12] "." b[o + 13] "." b[o + 14] "." b[o + 15]
}
# String of len bytes at offset off in the table.
function str(off, len,   s, i) {
  if (off + len > size) fail("string outside the table")
  s = ""
  for (i = 0; i < len; i++) s = s sprintf("%c", b[off + i])
  if (s !~ /^[A-Za-z0-9._:@-]+$/) fail("unexpected characters in a name")
  return s
}
# The structure of the given id at offset o, if it is there, at least minlen
# bytes long (the spec'"'"'s length of that structure) and valid, else 0.
function block(o, id, minlen) {
  if (o == 0 || o + 6 > size || b[o] != id || u16(o + 2) < minlen || o + u16(o + 2) > size) return 0
  return b[o + 5] % 2 == 1 ? o : 0
}
# The structure at o has the "firmware boot selected" flag.
function selected(o) { return int(b[o + 5] / 2) % 2 == 1 }
{ for (i = 1; i <= NF; i++) b[n++] = $i }
END {
  if (n < 48 || b[0] != 105 || b[1] != 66 || b[2] != 70 || b[3] != 84) fail("no iBFT signature")
  size = u32(4)
  if (size < 48 || size > n) fail("bad table length")
  sum = 0
  for (i = 0; i < size; i++) sum += b[i]
  if (sum % 256 != 0) fail("bad checksum")
  c = 48
  if (b[c] != 1) fail("no control structure")
  initiator_at = block(u16(c + 8), 2, 74)
  if (!initiator_at) fail("no initiator structure")
  tgt[0] = block(u16(c + 12), 4, 54)
  tgt[1] = block(u16(c + 16), 4, 54)
  target_at = tgt[0] ? tgt[0] : tgt[1]
  if (tgt[0] && tgt[1] && !selected(tgt[0]) && selected(tgt[1])) target_at = tgt[1]
  if (!target_at) fail("no target structure")
  nic[0] = block(u16(c + 10), 3, 102)
  nic[1] = block(u16(c + 14), 3, 102)
  if (!nic[0] && !nic[1]) fail("no NIC structure")
  t = target_at
  c = nic[0] ? nic[0] : nic[1]
  if (nic[0] && nic[1] && b[nic[1] + 4] == b[t + 33]) c = nic[1]
  if (b[c + 22] < 1 || b[c + 22] > 32) fail("bad prefix length")
  i = initiator_at
  print "IBFT_INITIATOR=" str(u16(i + 72), u16(i + 70))
  printf "IBFT_MAC=%02x:%02x:%02x:%02x:%02x:%02x\n", b[c + 90], b[c + 91], b[c + 92], b[c + 93], b[c + 94], b[c + 95]
  print "IBFT_IP=" ip4(c + 6)
  print "IBFT_PREFIX=" b[c + 22]
  print "IBFT_GATEWAY=" ip4(c + 24)
  print "IBFT_TARGET_IP=" ip4(t + 6)
  print "IBFT_TARGET_PORT=" u16(t + 22)
  print "IBFT_TARGET_NAME=" str(u16(t + 36), u16(t + 34))
}'
